{
  "name": "orbit-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Live monitoring dashboard for ORBIT test runs. Built assets are embedded into the orbit binary and served by `orbit serve`.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.7",
    "echarts": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
