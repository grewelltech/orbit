#!/bin/sh
# Install this node's netplan from its seed volume, before networking starts.
#
# The testbox image is shared by every node, so per-node addressing cannot be
# baked into it. Each VM instead gets a small read-only seed volume carrying
# exactly its own netplan; this copies it into /etc/netplan so the configuration
# is present *on disk*, which is what Aether OnRamp and SD-Core inspect to
# discover interfaces and addresses. A DHCP lease would leave nothing to read.
set -eu

LABEL=${ORBIT_SEED_LABEL:-ORBITNET}
MNT=/run/orbit-seed

dev=$(blkid -L "$LABEL" 2>/dev/null || true)
if [ -z "$dev" ]; then
    echo "orbit-netcfg: no volume labelled $LABEL; leaving the image default in place" >&2
    exit 0
fi

mkdir -p "$MNT"
mount -o ro "$dev" "$MNT"

# The seed owns addressing, so drop the image's DHCP-everything default rather
# than layering on top of it — netplan merges by filename and leaving it would
# put a DHCP lease alongside the static address.
rm -f /etc/netplan/99-testbox.yaml

for f in "$MNT"/*.yaml; do
    [ -e "$f" ] || continue
    install -m 600 "$f" "/etc/netplan/$(basename "$f")"
    echo "orbit-netcfg: installed $(basename "$f")" >&2
done

umount "$MNT"
netplan generate
