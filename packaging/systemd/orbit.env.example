# Configuration for the orbit systemd service.
#
# ORBIT_ARGS is passed verbatim to `orbit serve` (see `orbit serve --help`).
# Empty (the default) listens on 127.0.0.1:8412 with the strict-3gpp core
# profile. The API carries subscriber credentials, so expose it beyond loopback
# only behind TLS / a trusted network.
#
# Examples:
#   ORBIT_ARGS=--listen 0.0.0.0:8412
#   ORBIT_ARGS=--core-profile sdcore --log-level debug
ORBIT_ARGS=
