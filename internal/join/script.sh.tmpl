#!/bin/sh
# orbit join: sets up this host as an N6 responder for an orbit server
# (ADR-0009). Generated by orbit serve for one join token; it expires, and
# the server keeps only its hash.
#
# Everything is in main, called on the last line only: a download cut short
# runs nothing. A partial main is a syntax error, and main refuses to run
# unless its call arrived whole, which ends with --run (every shorter
# prefix of the call ends with something else).
main() {
	set -eu
	umask 077
	eval "ORBIT_LAST=\${$#}"
	[ "$ORBIT_LAST" = --run ] || {
		echo "orbit join: this script is incomplete; download it again" >&2
		exit 1
	}

	ORBIT_SERVER={{q .ServerURL}}
	ORBIT_PIN={{q .CurlPin}}
	ORBIT_TOKEN={{q .Token}}
	ORBIT_NAME={{q .Name}}
	SHA256_AMD64={{q .SHA256.amd64}}
	SHA256_ARM64={{q .SHA256.arm64}}
	UE_POOLS={{q .UEPools}}
	UPF_N6={{q .Spec.UPFN6}}
	N6_SUBNET={{q .Spec.N6Subnet}}

	die() {
		echo "orbit join: $*" >&2
		exit 1
	}

	[ "$(uname -s)" = Linux ] || die "Linux only; this host runs $(uname -s)"
	case "$(uname -m)" in
	x86_64 | amd64) ARCH=amd64 WANT=$SHA256_AMD64 ;;
	aarch64 | arm64) ARCH=arm64 WANT=$SHA256_ARM64 ;;
	*) die "amd64 or arm64 only; this host is $(uname -m)" ;;
	esac
	[ -n "$WANT" ] || die "the server has no orbit binary for linux/$ARCH (orbit serve --join-binaries)"
	command -v curl >/dev/null 2>&1 || die "curl is required"
	command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required to verify the orbit binary (coreutils)"

	# Everything downloaded goes in a private directory, removed on exit.
	WORK=$(mktemp -d) || die "mktemp -d failed"
	trap 'rm -rf "$WORK"' EXIT
	trap 'exit 1' HUP INT TERM

	curl -fsS --proto '=https' -k --pinnedpubkey "$ORBIT_PIN" -o "$WORK/orbit" \
		"$ORBIT_SERVER/join/$ORBIT_TOKEN/bin/$ARCH" || die "downloading orbit for linux/$ARCH failed"
	# Checked before anything else touches it: never chmod or run an
	# unverified file.
	GOT=$(sha256sum "$WORK/orbit" | cut -d ' ' -f 1)
	[ "$GOT" = "$WANT" ] || die "the downloaded orbit's SHA-256 is $GOT, want $WANT; refusing to run it"
	chmod 0700 "$WORK/orbit"
	"$WORK/orbit" version >/dev/null || die "the downloaded orbit does not run on this host"

	# The responder's name: the token's, else this host's.
	NAME=$ORBIT_NAME
	[ -n "$NAME" ] || NAME=$(uname -n)

	echo "orbit join: verified orbit for linux/$ARCH (sha256 $WANT)"
	echo "orbit join: responder $NAME; UE pools $UE_POOLS via $UPF_N6, N6 $N6_SUBNET"
	echo "orbit join: this server does not set up the responder yet; nothing on this host was changed"
}

main "$@" --run
